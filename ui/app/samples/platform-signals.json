{
  "schemaVersion": "1.0",
  "id": "00000000-0000-4000-8000-000000000002",
  "name": "Sample – Platform signals",
  "description": "Works in any environment, even one without services: web frontends, synthetic locations and event counts, with KPI connections in green, orange and red.",
  "owner": "system",
  "createdAt": "2026-10-05T00:00:00.000Z",
  "updatedAt": "2026-10-05T00:00:00.000Z",
  "settings": {
    "background": "dots",
    "defaultTimeframe": {
      "from": "now()-2h",
      "to": "now()"
    },
    "refreshInterval": "off"
  },
  "nodes": [
    {
      "id": "n1",
      "type": "entityNode",
      "position": {
        "x": 0,
        "y": 120
      },
      "data": {
        "kind": "entity",
        "componentType": "frontend",
        "name": "Web frontends",
        "entities": [],
        "icon": "ApplicationsIcon",
        "failPoint": {
          "warningMin": 1,
          "failingMin": 2
        },
        "kpi": {
          "enabled": true,
          "title": "Events by kind (timeframe)",
          "items": [
            {
              "id": "k1",
              "dql": "fetch events\n| summarize events = count(), by: {event.kind}\n| sort events desc\n| limit 5",
              "valueField": "events",
              "labelMode": "column",
              "labelField": "event.kind",
              "unit": "events",
              "decimals": 0,
              "maxRows": 5
            },
            {
              "id": "k2",
              "dql": "fetch dt.system.events\n| summarize total = count()",
              "valueField": "total",
              "labelMode": "text",
              "labelText": "System events",
              "unit": "events",
              "decimals": 0,
              "maxRows": 5
            }
          ]
        },
        "entityDql": "smartscapeNodes \"FRONTEND\"\n| filter frontend.type == \"web\"\n| fields id, id_classic, name"
      }
    },
    {
      "id": "n2",
      "type": "customNode",
      "position": {
        "x": 420,
        "y": 0
      },
      "size": {
        "w": 300,
        "h": 260
      },
      "data": {
        "kind": "custom",
        "icon": "WorldmapIcon",
        "name": "Synthetic locations",
        "mode": "entities",
        "entities": {
          "dql": "smartscapeNodes \"SYNTHETIC_LOCATION\"\n| fields id, name\n| sort name asc\n| limit 12",
          "subNameField": "name",
          "criterion": "anyProblem"
        },
        "maxVisibleRows": 7
      }
    },
    {
      "id": "n3",
      "type": "customNode",
      "position": {
        "x": 420,
        "y": 340
      },
      "size": {
        "w": 300,
        "h": 130
      },
      "data": {
        "kind": "custom",
        "icon": "ApplicationsIcon",
        "name": "All frontends",
        "mode": "entities",
        "entities": {
          "dql": "smartscapeNodes \"FRONTEND\"\n| fields id, id_classic, name",
          "subNameField": "name",
          "criterion": "anyProblem"
        },
        "maxVisibleRows": 8
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "n1",
      "target": "n2",
      "sourceHandle": "r",
      "targetHandle": "l",
      "type": "kpi",
      "direction": "forward",
      "label": "Davis events",
      "kpi": {
        "dql": "fetch events\n| summarize v = count()",
        "unit": "events",
        "decimals": 0,
        "animated": true,
        "threshold": {
          "direction": "above",
          "warning": 1000,
          "failing": 5000
        }
      }
    },
    {
      "id": "e2",
      "source": "n1",
      "target": "n3",
      "sourceHandle": "r",
      "targetHandle": "l",
      "type": "kpi",
      "direction": "backward",
      "label": "System events",
      "kpi": {
        "dql": "fetch dt.system.events\n| summarize v = count()",
        "unit": "events",
        "decimals": 0,
        "animated": true,
        "threshold": {
          "direction": "above",
          "warning": 500,
          "failing": 1000
        }
      }
    },
    {
      "id": "e3",
      "source": "n2",
      "target": "n3",
      "sourceHandle": "b",
      "targetHandle": "t",
      "type": "kpi",
      "direction": "none",
      "label": "Davis events (low threshold)",
      "kpi": {
        "dql": "fetch events\n| summarize v = count()",
        "unit": "events",
        "decimals": 0,
        "animated": true,
        "threshold": {
          "direction": "above",
          "warning": 300,
          "failing": 1000
        }
      }
    }
  ]
}
