# Copy this file to .env (never commit .env) and fill in both values, then run: npm run deploy:token
# Not needed if you set them as Codespaces secrets.

# Platform URL of your environment (the one with .apps.): replace abc12345 with your environment id
DT_APP_ENVIRONMENT_URL=https://abc12345.apps.dynatrace.com

# Platform token with the scopes app-engine:apps:install, app-engine:apps:run and app-engine:apps:delete
# Create it at https://myaccount.dynatrace.com/platformTokens
DT_APP_PLATFORM_TOKEN=
